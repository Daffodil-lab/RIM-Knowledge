{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context-pack.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "objective", "atlasDigest", "limits", "unresolvedSelectors", "excludedCount", "files", "coverage"],
  "properties": {
    "schemaVersion": { "const": 1 }, "taskId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }, "objective": { "type": "string", "minLength": 1 }, "atlasDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "limits": { "type": "object", "additionalProperties": false, "required": ["maxFiles", "maxBytes"], "properties": { "maxFiles": { "type": "integer", "minimum": 1 }, "maxBytes": { "type": "integer", "minimum": 1 } } },
    "unresolvedSelectors": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "excludedCount": { "type": "integer", "minimum": 0 },
    "files": { "type": "array", "items": { "$ref": "#/$defs/file" } },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["requestedDomains", "requestedSelectors", "resolvedSelectors", "matchedFiles", "includedFiles", "includedBytes", "followedOwners", "excludedByLimit", "excludedByOwner", "truncated"],
      "properties": {
        "requestedDomains": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "requestedSelectors": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "resolvedSelectors": { "type": "array", "items": { "$ref": "#/$defs/resolvedSelector" } }, "matchedFiles": { "type": "integer", "minimum": 0 }, "includedFiles": { "type": "integer", "minimum": 0 }, "includedBytes": { "type": "integer", "minimum": 0 },
        "followedOwners": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "excludedByLimit": { "type": "array", "items": { "$ref": "#/$defs/exclusion" } }, "excludedByOwner": { "type": "array", "items": { "$ref": "#/$defs/ownerExclusion" } }, "truncated": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "file": { "type": "object", "additionalProperties": false, "required": ["repositoryId", "path", "bytes", "sha256", "domain", "title", "kind", "knowledgeRole", "canonicalFor", "canonicalScope", "authority", "status", "selectionReasons"], "properties": { "repositoryId": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 }, "bytes": { "type": "integer", "minimum": 0 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "domain": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 }, "kind": { "enum": ["concept", "owner-document"] }, "knowledgeRole": { "type": ["string", "null"], "minLength": 1 }, "canonicalFor": { "type": ["string", "null"], "minLength": 1 }, "canonicalScope": { "type": ["string", "null"], "minLength": 1 }, "authority": { "type": ["string", "null"], "minLength": 1 }, "status": { "type": ["string", "null"], "minLength": 1 }, "selectionReasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } },
    "resolvedSelector": { "type": "object", "additionalProperties": false, "required": ["selector", "matchedBy", "paths"], "properties": { "selector": { "type": "string", "minLength": 1 }, "matchedBy": { "enum": ["canonical_for", "path"] }, "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } },
    "exclusion": { "type": "object", "additionalProperties": false, "required": ["repositoryId", "path", "reason"], "properties": { "repositoryId": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 }, "reason": { "enum": ["max-files", "max-bytes"] } } },
    "ownerExclusion": { "type": "object", "additionalProperties": false, "required": ["repositoryId", "path", "missingOwners"], "properties": { "repositoryId": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 }, "missingOwners": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } } }
  }
}
