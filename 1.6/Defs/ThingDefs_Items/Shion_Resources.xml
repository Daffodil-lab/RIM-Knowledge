<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef Name="ShionResourceBase" ParentName="ResourceBase" Abstract="True">
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <stackLimit>250</stackLimit>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Cutout</shaderType>
      <drawSize>(0.65,0.65)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <DeteriorationRate>0.5</DeteriorationRate>
      <Flammability>0</Flammability>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="ShionResourceBase">
    <defName>Shion_Cell</defName>
    <label>Cell</label>
    <description>A standardized physical industrial medium used to construct and maintain Shion systems.</description>
    <graphicData>
      <texPath>Things/Item/ShionResources/ShionResource</texPath>
      <color>(0.82,0.20,0.22)</color>
    </graphicData>
    <statBases>
      <MarketValue>12</MarketValue>
      <Mass>0.12</Mass>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="ShionResourceBase">
    <defName>Shion_EnergyCrystal</defName>
    <label>energy crystal</label>
    <description>A physical crystal that transports and stores energy for bodies, equipment, and remote installations.</description>
    <graphicData>
      <texPath>Things/Item/ShionResources/ShionResource</texPath>
      <color>(0.34,0.76,0.92)</color>
    </graphicData>
    <statBases>
      <MarketValue>18</MarketValue>
      <Mass>0.08</Mass>
    </statBases>
