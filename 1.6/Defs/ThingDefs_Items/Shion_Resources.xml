  </ThingDef>

  <ThingDef ParentName="ShionManufacturedBase">
    <defName>Shion_ClockworkRelay</defName>
    <label>clockwork relay</label>
    <description>A completed Shion control relay produced through the Kombinat's three-stage chain.</description>
