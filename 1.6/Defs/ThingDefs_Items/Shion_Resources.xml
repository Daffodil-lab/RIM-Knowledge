    <graphicData>
      <texPath>Things/Item/ShionResources/ShionResource</texPath>
      <color>(0.88,0.82,0.60)</color>
    </graphicData>
    <statBases>
      <MarketValue>10</MarketValue>
      <Mass>0.18</Mass>
    </statBases>
