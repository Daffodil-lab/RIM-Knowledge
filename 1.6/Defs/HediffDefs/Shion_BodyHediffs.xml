<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>Shion_CellLoss</defName>
    <label>Cell loss</label>
    <description>Loss of the circulating Cell medium. Complete depletion disables movement but does not kill a Shion.</description>
    <maxSeverity>1</maxSeverity>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.1</severityPerDay>
        <showDaysToRecover>true</showDaysToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <label>trace</label>
        <becomeVisible>false</becomeVisible>
      </li>
      <li>
        <minSeverity>0.15</minSeverity>
        <label>minor</label>
      </li>
      <li>
        <minSeverity>0.50</minSeverity>
        <label>major</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.75</minSeverity>
        <label>severe</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.2</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.999</minSeverity>
        <label>depleted</label>
        <lifeThreatening>false</lifeThreatening>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <setMax>0</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Shion_FluidReprocessingOffline</defName>
    <label>fluid reprocessing offline</label>
    <description>Both fluid reprocessors are unavailable. The body remains alive but cannot act until one is restored.</description>
    <maxSeverity>1</maxSeverity>
    <isBad>true</isBad>
    <stages>
      <li>
        <label>offline</label>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <setMax>0</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
